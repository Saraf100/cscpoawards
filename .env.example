# Production server environment example (set values in the host's private environment)
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DATABASE_NAME
NODE_ENV=production
PUBLIC_APP_URL=https://awards.cscpo.org
VOTER_SESSION_SECRET=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_32

# Email OTP delivery: use a verified sender domain in Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=CSCPO Awards <awards@YOUR_VERIFIED_DOMAIN>

# Google OAuth. Redirect URI: https://awards.cscpo.org/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Login. Redirect URI: https://awards.cscpo.org/api/auth/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v27.0
